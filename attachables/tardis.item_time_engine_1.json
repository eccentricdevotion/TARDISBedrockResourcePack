{
  "format_version": "1.21.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "tardis:item/time_rotor/engine/engine_1",
      "materials": {
        "enchanted": "entity_alphatest_glint",
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/item/time_rotor/engine_base",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.tardis.item_time_engine_1"
      },
      "animations": {
        "third_person": "animation.tardis.item_time_engine_1.hold_third_person",
        "head": "animation.tardis.item_time_engine_1.head",
        "first_person": "animation.tardis.item_time_engine_1.hold_first_person"
      },
      "scripts": {
        "animate": [
          {
            "first_person": "context.is_first_person == 1.0 && (context.item_slot == 'main_hand' || context.item_slot == 'off_hand')"
          },
          {
            "third_person": "context.is_first_person == 0.0 && (context.item_slot == 'main_hand' || context.item_slot == 'off_hand')"
          },
          {
            "head": "context.is_first_person == 0.0 && context.item_slot == 'head'"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}